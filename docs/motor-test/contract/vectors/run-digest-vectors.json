          "bemf_v": 3.1,
          "status_flags": 15
        }
      ],
      "expected_digest": "sha256:2fd7e06e4312214d4acd68de6f032aac6ecfd650e1d92bc17e21ab3c844be315"
    },
    {
      "id": "V7",
      "description": "negative rpm_actual (int32)",
      "samples": [
        {
          "sample_seq": 0,
          "t_ms": 0,
          "rpm_cmd": 0,
          "rpm_actual": -3,
          "current_a": 0,
          "voltage_v": 48,
          "bemf_v": null,
          "status_flags": 7
        }
      ],
      "expected_digest": "sha256:7cda0eb89de5a74293773e7a6a76c675c19bc68303c2f052c206a589c162de76"
    },
    {
      "id": "V8",
      "description": "reserved status_flags bit set",
      "samples": [
        {
          "sample_seq": 0,
          "t_ms": 0,
          "rpm_cmd": 0,
          "rpm_actual": 0,
          "current_a": 0,
          "voltage_v": 48,
          "bemf_v": null,
          "status_flags": 263
        }
      ],
      "expected_rejection": {
        "status": 400,
        "code": "VALIDATION_ERROR",
        "path": "samples[0].status_flags",
        "note": "Upload rejected before the database transaction; nothing is stored."
      }
    },
    {
      "id": "V9",
      "description": "validity bit set (b1=1) but value is null",
      "samples": [
        {
          "sample_seq": 0,
          "t_ms": 0,
          "rpm_cmd": 0,
          "rpm_actual": 0,
          "current_a": null,
          "voltage_v": 48,
          "bemf_v": null,
          "status_flags": 7
        }
      ],
      "expected_rejection": {
        "status": 422,
        "code": "INCONSISTENT_RUN",
        "path": "samples[0].current_a",
        "note": "Upload rejected before the database transaction; nothing is stored."
      }
    }
  ]
}
