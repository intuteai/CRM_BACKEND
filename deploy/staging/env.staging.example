# Copy to ~/erp-staging/.env.staging on the EC2 host and fill in. NEVER commit the real file.
# Values here override the .env baked into the image (dotenv never overrides existing variables).
DB_HOST=<same RDS host as production>
DB_PORT=5432
DB_NAME=erp_staging
DB_USER=erp_staging_app
DB_PASSWORD=<erp_staging_app password>
# A NEW secret, different from production, so staging and production logins can never be swapped:
JWT_SECRET=<random 48+ characters>
FRONTEND_URL=https://intute.biz
# Leave mail empty on staging so no real emails are sent:
EMAIL_USER=
EMAIL_PASS=
MANAGER_DAILY_REPORT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PATH=
GOOGLE_DRIVE_FOLDER_ID=
